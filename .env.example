# Copy this file to .env and fill in real values. Never commit .env itself.

# Use SQLite for quick local dev (no setup needed), Postgres for production
DATABASE_URL=sqlite:///./agrisync.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agrisync

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0

# Create a free API key at https://data.gov.in and keep it server-side.
DATA_GOV_IN_API_KEY=your-data-gov-in-key-here
# Optional: set this only if you choose a different data.gov.in catalog.
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
